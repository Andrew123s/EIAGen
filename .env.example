# Copy to .env and edit. Never commit .env.

# --- LLM provider -----------------------------------------------------------
# rule_based (default, no key needed) | anthropic | openai_compatible
EIAGEN_LLM_PROVIDER=rule_based
# Anthropic (Claude) settings - used when EIAGEN_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
EIAGEN_ANTHROPIC_MODEL=claude-opus-5-5
EIAGEN_ANTHROPIC_EFFORT=medium
# OpenAI-compatible endpoint (e.g. a local Ollama server at http://localhost:11434/v1)
EIAGEN_OPENAI_BASE_URL=http://localhost:11434/v1
EIAGEN_OPENAI_MODEL=llama3.1:8b
EIAGEN_OPENAI_API_KEY=

# --- Retrieval --------------------------------------------------------------
# sentence_transformers (default if installed) | hashing (fast, offline, lexical)
EIAGEN_EMBEDDING_BACKEND=sentence_transformers
EIAGEN_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Storage ----------------------------------------------------------------
EIAGEN_DATABASE_URL=sqlite:///data/eiagen.db

# --- Access control ---------------------------------------------------------
# Leave empty for local single-user mode. When set, write endpoints require
# the X-API-Key header; regulatory-library changes require the admin key.
EIAGEN_API_KEY=
EIAGEN_ADMIN_API_KEY=

# --- Frontend ---------------------------------------------------------------
EIAGEN_API_URL=http://127.0.0.1:8000
